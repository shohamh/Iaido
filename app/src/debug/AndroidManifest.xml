<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".ImeTestHostActivity"
            android:exported="true"
            android:label="Iaido IME Test Host"
            android:process=":ime_test_host"
            android:theme="@style/ImeTestHostTheme"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />
        <receiver
            android:name=".ImeTestHostResetReceiver"
            android:exported="true"
            android:process=":ime_test_host">
            <intent-filter>
                <action android:name="com.iaido.app.action.RESET_EDITOR" />
            </intent-filter>
        </receiver>
        <service
            android:name=".ReferenceInputMethodService"
            android:exported="true"
            android:label="Iaido Reference Keyboard"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/reference_input_method" />
        </service>
    </application>
</manifest>
